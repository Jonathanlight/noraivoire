{
  "$nora": "component",
  "$version": "1.0.0",
  "component": "radio",
  "shape": "toggle",
  "description": "Bouton radio : un <label class=\"radio\"> contenant <input type=\"radio\" name=\"…\"> et son texte (zone cliquable ≥ 44 px). Grouper les options d'une même question dans un <fieldset class=\"field\"> avec <legend class=\"field-label\">.",
  "elements": [
    "label"
  ],
  "variants": {
    "tone": [
      "primary",
      "neutral",
      "danger",
      "success",
      "warning"
    ],
    "size": [
      "sm",
      "md",
      "lg"
    ]
  },
  "defaults": {
    "tone": "primary",
    "size": "md"
  },
  "tokens": {
    "bg": "{color.surface}",
    "fg": "{color.text}",
    "radius": "{radius.full}",
    "border": "{color.text-muted}",
    "accent": "{color.$tone}",
    "on-accent": "{color.on-$tone}",
    "focus": "{color.focus}",
    "invalid": "{color.danger}"
  },
  "sizes": {
    "sm": {
      "pad-y": 4,
      "pad-x": 8,
      "font": "{font.sm}"
    },
    "md": {
      "pad-y": 6,
      "pad-x": 10,
      "font": "{font.md}"
    },
    "lg": {
      "pad-y": 8,
      "pad-x": 12,
      "font": "{font.lg}"
    }
  },
  "states": {
    "focus": {
      "ring": 2,
      "token": "focus"
    },
    "invalid": {
      "token": "invalid"
    },
    "disabled": {
      "opacity": 0.5
    }
  },
  "motion": {
    "press": {
      "duration": "{duration.fast}"
    }
  },
  "a11y": {
    "role": "radio",
    "inputType": "radio",
    "minTarget": 44,
    "requiresLabel": true,
    "anchorRequiresHref": false
  },
  "feedback": {
    "haptic": "light"
  },
  "example": "<fieldset class=\"field\"><legend class=\"field-label\">Livraison</legend><label class=\"radio\"><input type=\"radio\" name=\"livraison\" value=\"standard\" checked> Standard</label><label class=\"radio\"><input type=\"radio\" name=\"livraison\" value=\"express\"> Express</label></fieldset>"
}
