{
  "$nora": "tokens",
  "$version": "1.0.0",
  "color": {
    "primary":    { "$type": "color", "$value": "#C1470B", "$dark": "#FF8A3D" },
    "on-primary": { "$type": "color", "$value": "#FFFFFF", "$dark": "#1A0F08" },
    "neutral":    { "$type": "color", "$value": "#3B3F46", "$dark": "#D5D8DD" },
    "on-neutral": { "$type": "color", "$value": "#FFFFFF", "$dark": "#14161A" },
    "danger":     { "$type": "color", "$value": "#C92A2A", "$dark": "#FF6B6B" },
    "on-danger":  { "$type": "color", "$value": "#FFFFFF", "$dark": "#1F0A0A" },
    "success":    { "$type": "color", "$value": "#1B7F3B", "$dark": "#51CF66" },
    "on-success": { "$type": "color", "$value": "#FFFFFF", "$dark": "#08180C" },
    "warning":    { "$type": "color", "$value": "#AC5800", "$dark": "#FFC078" },
    "on-warning": { "$type": "color", "$value": "#FFFFFF", "$dark": "#1E1204" },
    "surface":    { "$type": "color", "$value": "#FFFFFF", "$dark": "#16181D" },
    "surface-2":  { "$type": "color", "$value": "#F4F5F7", "$dark": "#1F2228" },
    "text":       { "$type": "color", "$value": "#16181D", "$dark": "#EDEEF0" },
    "text-muted": { "$type": "color", "$value": "#5C626B", "$dark": "#A0A6AF" },
    "border":     { "$type": "color", "$value": "#DDE0E4", "$dark": "#2E323A" },
    "focus":      { "$type": "color", "$value": "#1C7ED6", "$dark": "#74C0FC" },
    "scrim":      { "$type": "color", "$value": "#0B0C0F", "$dark": "#0B0C0F" },
    "on-scrim":   { "$type": "color", "$value": "#FFFFFF", "$dark": "#FFFFFF" }
  },
  "space": {
    "0": { "$type": "dimension", "$value": 0 },
    "1": { "$type": "dimension", "$value": 4 },
    "2": { "$type": "dimension", "$value": 8 },
    "3": { "$type": "dimension", "$value": 12 },
    "4": { "$type": "dimension", "$value": 16 },
    "6": { "$type": "dimension", "$value": 24 },
    "8": { "$type": "dimension", "$value": 32 },
    "12": { "$type": "dimension", "$value": 48 }
  },
  "radius": {
    "none": { "$type": "dimension", "$value": 0 },
    "sm":   { "$type": "dimension", "$value": 4 },
    "md":   { "$type": "dimension", "$value": 8 },
    "lg":   { "$type": "dimension", "$value": 16 },
    "full": { "$type": "dimension", "$value": 9999 }
  },
  "font": {
    "sm": { "$type": "dimension", "$value": 14 },
    "md": { "$type": "dimension", "$value": 16 },
    "lg": { "$type": "dimension", "$value": 18 },
    "xl": { "$type": "dimension", "$value": 24 }
  },
  "duration": {
    "fast": { "$type": "duration", "$value": 150 },
    "base": { "$type": "duration", "$value": 250 },
    "slow": { "$type": "duration", "$value": 400 }
  }
}
