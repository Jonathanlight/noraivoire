{% extends 'base.html.twig' %}
{# Les valeurs de data-tone issues de variables doivent venir d'une liste blanche côté PHP (enum), jamais de l'utilisateur. #}

{% block body %}
  <section class="grid-auto">
    {% for product in products %}
      <article class="card fx-glass" data-fx="tilt reveal" data-fx-tilt="max:10">
        <div class="stack">
          <span class="badge" data-tone="{{ product.inStock ? 'success' : 'warning' }}">
            {{ product.inStock ? 'En stock' : 'Sur commande' }}
          </span>
          <h2 class="text-lg font-bold">{{ product.name }}</h2>
          <p class="text-muted">{{ product.description }}</p>
          <twig:Nora:Btn tone="primary" href="{{ path('product_show', {id: product.id}) }}">Voir</twig:Nora:Btn>
        </div>
      </article>
    {% else %}
      <p class="text-muted">Aucun produit.</p>
    {% endfor %}
  </section>

  {# Formulaire : label relié par for/id ; en cas d'erreur, aria-invalid et aria-describedby vers le message. #}
  <section class="card"><form class="stack" method="post" action="{{ path('contact') }}">
    <div class="field">
      <label class="field-label" for="contact-email">E-mail</label>
      <input class="input" id="contact-email" type="email" name="email" value="{{ last_email|default('') }}" autocomplete="email" required
        {% if email_error %}aria-invalid="true" aria-describedby="contact-email-erreur"{% endif %}>
      {% if email_error %}<p class="field-error" id="contact-email-erreur">{{ email_error }}</p>{% endif %}
    </div>
    <div class="field">
      <label class="field-label" for="contact-sujet">Sujet</label>
      <select class="select" id="contact-sujet" name="sujet">
        {% for sujet in sujets %}<option value="{{ sujet.value }}">{{ sujet.label }}</option>{% endfor %}
      </select>
    </div>
    <div class="field">
      <label class="field-label" for="contact-message">Message</label>
      <textarea class="textarea" id="contact-message" name="message" rows="4" required></textarea>
    </div>
    <label class="checkbox"><input type="checkbox" name="copie"> Recevoir une copie</label>
    <input type="hidden" name="_token" value="{{ csrf_token('contact') }}">
    <button class="btn" type="submit">Envoyer</button>
  </form></section>
{% endblock %}
