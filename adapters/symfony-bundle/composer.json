{
    "name": "noraivoire/symfony-bundle",
    "description": "NoraIvoire pour Symfony : Twig Components Nora:*, enums PHP, AssetMapper et commande nora:check. Logiciel propriétaire © Jonathan KABLAN — distribution réservée aux licenciés, jamais sur Packagist.",
    "type": "symfony-bundle",
    "license": "proprietary",
    "authors": [
        { "name": "Jonathan KABLAN" }
    ],
    "require": {
        "php": ">=8.4",
        "symfony/asset-mapper": "^7.3 || ^8.0",
        "symfony/config": "^7.3 || ^8.0",
        "symfony/console": "^7.3 || ^8.0",
        "symfony/dependency-injection": "^7.3 || ^8.0",
        "symfony/framework-bundle": "^7.3 || ^8.0",
        "symfony/http-kernel": "^7.3 || ^8.0",
        "symfony/process": "^7.3 || ^8.0",
        "symfony/twig-bundle": "^7.3 || ^8.0",
        "symfony/ux-twig-component": "^2.25",
        "twig/twig": "^3.15"
    },
    "require-dev": {
        "phpunit/phpunit": "^12.0"
    },
    "autoload": {
        "psr-4": {
            "NoraIvoire\\SymfonyBundle\\": "src/",
            "NoraIvoire\\SymfonyBundle\\Generated\\": "generated/src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "NoraIvoire\\SymfonyBundle\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {}
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "archive": {
        "exclude": ["/tests", "/tool", "/phpunit.xml.dist"]
    }
}
