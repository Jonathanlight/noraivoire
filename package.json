{
  "name": "@noraivoire/monorepo",
  "version": "0.1.0",
  "private": true,
  "license": "UNLICENSED",
  "description": "NoraIvoire — langage de design universel : une spec, des sorties CSS, Flutter et React Native. Propriétaire.",
  "author": "Jonathan KABLAN",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "node packages/compiler/src/cli.js build --spec spec --out packages/core/dist",
    "check": "node packages/cli/src/cli.js check templates recipes --format=text",
    "test": "node --test tests/unit/*.test.js",
    "audit:deps": "npm audit --omit=dev --audit-level=moderate",
    "audit:security": "node packages/cli/src/cli.js audit",
    "flutter:sync": "node examples/flutter_app/tool/sync.mjs",
    "jsp:sync": "node examples/jsp-app/tool/sync.mjs",
    "jsp:serve": "node examples/jsp-app/tool/serve.mjs",
    "symfony:sync": "node adapters/symfony-bundle/tool/sync.mjs",
    "verify": "npm run build && npm test && npm run check && npm run audit:security",
    "bench": "node bench/run.js",
    "bench:dry": "node bench/run.js --dry-run",
    "test:visual": "playwright test",
    "test:visual:update": "node tests/visual/update.mjs",
    "parity:update": "node tests/parity/update.mjs",
    "test:jsp": "node --test --test-concurrency=1 tests/jsp/run.mjs",
    "test:rn": "jest -c tests/rn/jest.config.cjs",
    "audit:licenses": "node tests/rn/check-licenses.mjs",
    "gallery": "node tests/gallery/run.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@babel/core": "7.29.7",
    "@playwright/test": "1.63.0",
    "@react-native/babel-preset": "0.87.1",
    "@react-native/jest-preset": "0.87.1",
    "@testing-library/react-native": "14.0.1",
    "jest": "29.7.0",
    "jsdom": "^26.1.0",
    "react": "19.2.3",
    "react-native": "0.87.1",
    "test-renderer": "1.3.0"
  }
}
