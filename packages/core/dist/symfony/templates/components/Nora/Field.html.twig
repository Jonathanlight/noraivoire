{# Twig Component anonyme : <twig:Nora:Field tone="…" size="…">…</twig:Nora:Field>
   Valeurs hors liste blanche → valeur par défaut. data-tone, data-size ne peuvent pas être forcés par attribut. #}
{% props tone = 'neutral', size = 'md', as = 'div' %}
{% set tone = tone in ['neutral'] ? tone : 'neutral' %}
{% set size = size in ['sm', 'md', 'lg'] ? size : 'md' %}
{% set as = as in ['div', 'fieldset'] ? as : 'div' %}
{% set attrs = attributes.without('data-tone', 'data-size') %}
{% if as == 'div' %}
  <div {{ attrs.defaults({class: 'field', 'data-tone': tone, 'data-size': size}) }}>{% block content %}{% endblock %}</div>
{% else %}
  <fieldset {{ attrs.defaults({class: 'field', 'data-tone': tone, 'data-size': size}) }}>{{ block('content') }}</fieldset>
{% endif %}
