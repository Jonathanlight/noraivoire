{# Twig Component anonyme : <twig:Nora:Card tone="…" size="…">…</twig:Nora:Card>
   Valeurs hors liste blanche → valeur par défaut. data-tone, data-size ne peuvent pas être forcés par attribut. #}
{% props tone = 'neutral', size = 'md', as = 'div' %}
{% set tone = tone in ['neutral'] ? tone : 'neutral' %}
{% set size = size in ['sm', 'md', 'lg'] ? size : 'md' %}
{% set as = as in ['div', 'article', 'section', 'li'] ? as : 'div' %}
{% set attrs = attributes.without('data-tone', 'data-size') %}
{% if as == 'div' %}
  <div {{ attrs.defaults({class: 'card', 'data-tone': tone, 'data-size': size}) }}>{% block content %}{% endblock %}</div>
{% elseif as == 'article' %}
  <article {{ attrs.defaults({class: 'card', 'data-tone': tone, 'data-size': size}) }}>{{ block('content') }}</article>
{% elseif as == 'section' %}
  <section {{ attrs.defaults({class: 'card', 'data-tone': tone, 'data-size': size}) }}>{{ block('content') }}</section>
{% else %}
  <li {{ attrs.defaults({class: 'card', 'data-tone': tone, 'data-size': size}) }}>{{ block('content') }}</li>
{% endif %}
