{# Twig Component anonyme : <twig:Nora:Btn tone="…" size="…">…</twig:Nora:Btn>
   Valeurs hors liste blanche → valeur par défaut. data-tone, data-size, href, type ne peuvent pas être forcés par attribut. #}
{% props tone = 'primary', size = 'md', href = null, type = 'button' %}
{% set tone = tone in ['primary', 'neutral', 'danger', 'success', 'warning'] ? tone : 'primary' %}
{% set size = size in ['sm', 'md', 'lg'] ? size : 'md' %}
{% set href = href is iterable or href is null ? null : href ~ '' %}
{% set href = href and (href starts with '/' or href starts with '#' or href starts with 'https://' or href starts with 'http://' or href starts with 'mailto:' or href starts with 'tel:') and not (href starts with '//' or href starts with '/\\') ? href : null %}
{% set type = type in ['button', 'submit', 'reset'] ? type : 'button' %}
{% set attrs = attributes.without('data-tone', 'data-size', 'href', 'type') %}
{% if href %}
  <a {{ attrs.defaults({class: 'btn', 'data-tone': tone, 'data-size': size, href: href}) }}>{% block content %}{% endblock %}</a>
{% else %}
  <button {{ attrs.defaults({class: 'btn', 'data-tone': tone, 'data-size': size, type: type}) }}>{{ block('content') }}</button>
{% endif %}
